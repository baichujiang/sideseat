{
  "name": "sideseat",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "db:start": "node scripts/start-local-db.mjs",
    "dev": "next dev",
    "dev:clean": "sh -c 'chmod -R u+w .next 2>/dev/null || true; rm -rf .next'",
    "dev:reset": "npm run dev:clean && npm run dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "smoke:auth": "tsx scripts/smoke-auth.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "e2e:course-id": "tsx scripts/print-e2e-course-id.ts",
    "sync:course-instructors": "tsx scripts/sync-course-instructors.ts",
    "sync:tum-exam-catalog": "tsx scripts/sync-tum-exam-catalog.ts",
    "sync:lmu-lsf-catalog": "tsx scripts/sync-lmu-lsf-catalog.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed:test-accounts": "tsx scripts/seed-test-accounts.ts",
    "cap:sync": "cap sync ios",
    "cap:open:ios": "cap open ios",
    "cap:run:ios": "cap run ios",
    "ios:dev": "CAPACITOR_SERVER_URL=http://localhost:3000 cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "^5.18.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.2.0",
    "jose": "^5.6.3",
    "lucide-react": "^0.441.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "resend": "^6.12.0",
    "stripe": "^17.7.0",
    "tailwind-merge": "^2.5.2",
    "web-push": "^3.6.7",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^15.5.15",
    "@playwright/test": "^1.50.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.7.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "^18.3.0-beta.17",
    "eslint": "^9.11.1",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.47",
    "prisma": "^5.18.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
