# Copy to .env for local dev, or paste into your host's env panel for prod.

# Postgres connection string. Use Neon/Supabase/Railway in production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sideseat"

# Long random string (>= 32 chars). Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-secret"

# Public URL the browser uses to reach this app. MUST be a real https URL in
# production — verification emails embed it, and university inboxes reject
# messages that contain localhost links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Comma-separated list of admin login emails.
ADMIN_EMAILS="lin@example.com"

# Resend credentials. The `from` domain must be verified in Resend.
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_FROM="SideSeat <noreply@sideseat.de>"
