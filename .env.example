# Copy to `.env` and fill values. Do not commit `.env`.

# Remote Postgres (Neon Quick start — copy both from the dashboard).
# Recommended (pooled, host contains "-pooler"):
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# For uses requiring a connection without pgbouncer (migrations):
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Local builds do not migrate a remote database unless this one-shot approval is set.
# ALLOW_REMOTE_DATABASE_MIGRATIONS=1
# Use for compile-only builds that must skip migrations regardless of target.
# SKIP_DATABASE_MIGRATIONS=1
SESSION_SECRET="replace-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Canonical Universal Link origin for links shared from the native iPhone app.
# Production defaults to https://www.sideseat.de when omitted.
SIDESEAT_PUBLIC_SHARE_ORIGIN="http://localhost:3000"
# Optional App Store or TestFlight install page shown by the native handoff page.
# NEXT_PUBLIC_IOS_INSTALL_URL="https://apps.apple.com/app/id0000000000"
# Emergency rollback only. Production defaults to the iPhone-only web surface.
# SIDESEAT_ENABLE_LEGACY_WEB="true"

# Capacitor iOS shell — URL loaded in WKWebView (see docs/CAPACITOR_IOS.md)
# Local: CAPACITOR_SERVER_URL=http://localhost:3000
# Production: must match NEXT_PUBLIC_APP_URL (same https host, no trailing slash)
# CAPACITOR_SERVER_URL=https://your-production-host

# Email signup OTP (required — no local auto-fill fallback)
RESEND_API_KEY=
EMAIL_FROM=SideSeat <onboarding@resend.dev>

# Public media store for profile photos, chat images, and Discover images.
BLOB_READ_WRITE_TOKEN=
# Separate private Blob store for enrollment or graduation documents.
VERIFICATION_BLOB_READ_WRITE_TOKEN=

# Optional: JWT access tokens (defaults to SESSION_SECRET if unset)
# ACCESS_TOKEN_SECRET=

# Native iOS compatibility response (`GET /api/v1/client-config`).
IOS_MINIMUM_SUPPORTED_VERSION=1.0.0
IOS_LATEST_VERSION=1.0.0
# IOS_MAINTENANCE_MODE=0

# B-light creator-gated Action enrollment. All values are required before a
# declared iOS capability is accepted; missing/invalid floors fail closed.
# Keep disabled until the compatible native build is approved for the cohort.
# V2_GLOBAL_KILL_SWITCH=0
# V2_ACTION_TO_PLAN_EXPERIMENT_ENABLED=0
# V2_ACTION_INTEREST_ENABLED=0
# V2_WEEKLY_INTENT_ENABLED=0
# V2_MUTUAL_OPPORTUNITY_ENABLED=0
# V2_ACTIVITY_FIT_ENABLED=0 # Enable related activities only after all internal clients support activity-fit cards.
# V2_FLEXIBLE_TIMING_ENABLED=0 # Enable only after migration, backend and compatible internal clients are ready.
# V2_AUTOMATIC_MATCHING_ENABLED=0 # Explicit publication replaces sessions for new intents; preserve legacy consent.
# V2_MEET_AGAIN_ENABLED=0 # Layer 3: enable only after reviewed migration and internal acceptance.
# V2_CREATOR_GATED_EXPERIMENT_ENABLED=0
# The two Together flags above apply to every authenticated user. This generic
# allowlist remains only for legacy/creator-gated V2 experiments.
# V2_TESTFLIGHT_ALLOWLIST=user-id-or-email
# V2_ACTION_COORDINATION_IOS_MIN_VERSION=1.0.0
# V2_ACTION_COORDINATION_IOS_MIN_BUILD=1

# --- Stripe tips (Me → Tip card, `/api/tip/checkout`) ---
# Get test keys: https://dashboard.stripe.com/test/apikeys
# Production: use live keys from https://dashboard.stripe.com/apikeys
# Test card: 4242 4242 4242 4242, any future expiry, any CVC.
STRIPE_SECRET_KEY=

# Optional: higher-quality static map thumbnails in chat location messages.
# GOOGLE_MAPS_STATIC_API_KEY=

# --- Natural language calendar (Home → sparkle button, Alibaba DashScope / 通义千问) ---
# Create a key: https://bailian.console.aliyun.com/ → API Key
# Compatible endpoint (default): https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional: local Postgres only if you explicitly want it (not required for dev).
# npm run db:start
# Authorizes Vercel cron routes. Use one long, random production secret.
CRON_SECRET=""
# One independent heartbeat per scheduled job. Each endpoint receives a JSON
# payload. Healthchecks-style services normally use the check URL for success
# and its `/fail` URL for failure. Keep this JSON as one line in Vercel.
CRON_MONITOR_URLS='{"chat-realtime-retention":{"successUrl":"https://monitor.example/check-1","failureUrl":"https://monitor.example/check-1/fail"},"student-verification-retention":{"successUrl":"https://monitor.example/check-2","failureUrl":"https://monitor.example/check-2/fail"},"product-funnel-retention":{"successUrl":"https://monitor.example/check-3","failureUrl":"https://monitor.example/check-3/fail"},"social-group-expiration":{"successUrl":"https://monitor.example/check-4","failureUrl":"https://monitor.example/check-4/fail"},"tum-course-catalog":{"successUrl":"https://monitor.example/check-5","failureUrl":"https://monitor.example/check-5/fail"},"lmu-course-catalog":{"successUrl":"https://monitor.example/check-6","failureUrl":"https://monitor.example/check-6/fail"}}'
# Legacy fallback for local/non-production installations only.
# CRON_MONITOR_URL=
# Durable chat change events older than this are pruned. Native clients with
# an older cursor receive a reset signal and reload conversation history.
CHAT_REALTIME_RETENTION_DAYS="14"

# --- Production database recovery gate ---
# Example provider: neon. Keep at least seven days of point-in-time restore or snapshots.
DATABASE_BACKUP_PROVIDER=neon
DATABASE_BACKUP_RETENTION_DAYS=7
# Update only after restoring a recent backup into an isolated branch and verifying it.
DATABASE_RESTORE_TESTED_AT=

# --- Native iOS push (environment-scoped APNs Auth Keys) ---
# Apple recommends separate Team Scoped keys for Sandbox and Production.
# Configure the matching pair(s); client-config.features.apnsDelivery becomes
# true when at least one environment is ready.
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=app.sideseat.mobile
# APNS_SANDBOX_KEY_ID=
# APNS_SANDBOX_KEY_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_PRODUCTION_KEY_ID=
# APNS_PRODUCTION_KEY_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Compatibility only: one legacy key can serve the default environment below.
# APNS_KEY_ID=
# APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_USE_SANDBOX=1

# --- Universal Links (AASA at /.well-known/apple-app-site-association) ---
# Same 10-character Team ID as APNS_TEAM_ID / Xcode DEVELOPMENT_TEAM.
# When unset, AASA returns empty appIDs (links will not open the native app).
# APPLE_TEAM_ID=
# Optional override (defaults to app.sideseat.mobile):
# APPLE_BUNDLE_ID=app.sideseat.mobile

# --- StoreKit production verification (App Store Server API) ---
# Keep disabled for a release without in-app support purchases. When enabled,
# App Store products and all three Apple verification credentials are required.
# STOREKIT_SUPPORT_ENABLED=0
# STOREKIT_VERIFICATION_MODE=strict
# STOREKIT_APPLE_ISSUER_ID=
# STOREKIT_APPLE_KEY_ID=
# STOREKIT_APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Optional App Review / Settings links (defaults to NEXT_PUBLIC_APP_URL + /privacy|/support)
# NEXT_PUBLIC_PRIVACY_URL=https://sideseat.de/privacy
# NEXT_PUBLIC_SUPPORT_URL=https://sideseat.de/support
# Public contact address; configure only after the inbox can receive mail.
# NEXT_PUBLIC_SUPPORT_EMAIL=support@sideseat.de
