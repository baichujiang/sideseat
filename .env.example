# Copy to `.env` and fill values. Do not commit `.env`.

# Remote Postgres (Neon Quick start — copy both from the dashboard).
# Recommended (pooled, host contains "-pooler"):
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# For uses requiring a connection without pgbouncer (migrations):
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
SESSION_SECRET="replace-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Capacitor iOS shell — URL loaded in WKWebView (see docs/CAPACITOR_IOS.md)
# Local: CAPACITOR_SERVER_URL=http://localhost:3000
# Production: must match NEXT_PUBLIC_APP_URL (same https host, no trailing slash)
# CAPACITOR_SERVER_URL=https://your-production-host

# Email signup OTP (required — no local auto-fill fallback)
RESEND_API_KEY=
EMAIL_FROM=SideSeat <onboarding@resend.dev>

# Optional: JWT access tokens (defaults to SESSION_SECRET if unset)
# ACCESS_TOKEN_SECRET=

# --- Stripe tips (Me → Tip card, `/api/tip/checkout`) ---
# Get test keys: https://dashboard.stripe.com/test/apikeys
# Production: use live keys from https://dashboard.stripe.com/apikeys
# Test card: 4242 4242 4242 4242, any future expiry, any CVC.
STRIPE_SECRET_KEY=

# Optional: higher-quality static map thumbnails in chat location messages.
# GOOGLE_MAPS_STATIC_API_KEY=

# --- Natural language calendar (Home → sparkle button, Alibaba DashScope / 通义千问) ---
# Create a key: https://bailian.console.aliyun.com/ → API Key
# Compatible endpoint (default): https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional: local Postgres only if you explicitly want it (not required for dev).
# npm run db:start
