# Copy to .env for local dev, or paste into your host's env panel for prod.

# Postgres connection string.
#
# Local:
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sideseat"
#
# Neon (https://console.neon.tech):
# - DATABASE_URL: use the **pooled** connection (host contains `-pooler`) for the app runtime.
# - DIRECT_URL: use the **direct** connection (same branch, host without `-pooler`) for Prisma migrations.
#   Vercel: add BOTH to Project → Settings → Environment Variables. If DIRECT_URL is missing, the build
#   script falls back to DATABASE_URL so the build passes, but migrate may hit P1002 on the pooler —
#   always set DIRECT_URL to the non-pooler URI in production.
# Local dev: you can set both to the same direct URI if you are not using the pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require"

# Long random string (>= 32 chars). Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-long-random-secret"

# HS256 secret for short-lived JWT access tokens (>= 16 chars). Generate with: openssl rand -base64 32
ACCESS_TOKEN_SECRET="replace-with-a-different-long-secret-for-jwt"

# Public URL the browser uses to reach this app. MUST be a real https URL in
# production — verification emails embed it, and university inboxes reject
# messages that contain localhost links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional — if set, Me → Account shows a “Help & feedback” mail link.
# NEXT_PUBLIC_SUPPORT_EMAIL="hello@example.com"

# Admin access (Profile → Admin links, /admin/*). Use either or both:
# - ADMIN_EMAILS: comma-separated account emails (lowercase match).
# - ADMIN_USERNAMES: comma-separated login usernames (case-insensitive).
ADMIN_EMAILS="lin@example.com"
ADMIN_USERNAMES="your_handle"

# Resend credentials. The `from` domain must be verified in Resend.
RESEND_API_KEY="re_xxxxxxxxx"
EMAIL_FROM="SideSeat <noreply@sideseat.de>"

# Vercel Blob read/write token. Required for manual student-verification
# enrollment-certificate uploads and optional profile photo uploads
# (`/api/profile/avatar/upload`). Get it from the Vercel dashboard ->
# Storage -> Blob -> your store -> "Read/Write Token".
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxx"

# Web Push (VAPID). Generate once: npx web-push generate-vapid-keys
# VAPID_SUBJECT must be a mailto: or https: URL (see web-push docs).
# Never commit real keys — put the generated pair only in .env / host env.
VAPID_PUBLIC_KEY="BNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_PRIVATE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
VAPID_SUBJECT="mailto:you@example.com"

# Vercel Cron: same value must exist in the project env; Vercel sends
# Authorization: Bearer <CRON_SECRET> when hitting cron routes.
CRON_SECRET="replace-with-a-long-random-secret"
