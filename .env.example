# Copy to `.env` and fill values. Do not commit `.env`.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"
SESSION_SECRET="replace-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: JWT access tokens (defaults to SESSION_SECRET if unset)
# ACCESS_TOKEN_SECRET=

# --- Stripe tips (Me → Tip card, `/api/tip/checkout`) ---
# Get test keys: https://dashboard.stripe.com/test/apikeys
# Production: use live keys from https://dashboard.stripe.com/apikeys
# Test card: 4242 4242 4242 4242, any future expiry, any CVC.
STRIPE_SECRET_KEY=
