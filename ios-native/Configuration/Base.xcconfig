IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 29
CODE_SIGN_STYLE = Automatic
PRODUCT_BUNDLE_IDENTIFIER = app.sideseat.mobile
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
// Push: Development.xcconfig → development; Staging/Production → production
APS_ENVIRONMENT = development
// Override with the public HTTPS host serving the AASA file before release.
SIDESEAT_ASSOCIATED_DOMAIN = sideseat.invalid
// Optional crash DSN (empty = CrashReporting no-op)
SIDESEAT_CRASH_DSN =
// Build tool only. The auth token must come from the release environment.
SENTRY_CLI_PATH = $(SRCROOT)/../node_modules/.bin/sentry-cli
